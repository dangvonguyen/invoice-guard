# The root path for the API. This is the path that the API will be served from.
API_ROOT=/api

# List of origins that can access this API, separated by a comma,
# eg: CORS_ORIGINS=http://localhost,https://www.example.com
CORS_ORIGINS=*

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL. Defaults to INFO
LOG_LEVEL=INFO
# Comma-separated endpoints excluded from routine request logs.
LOG_EXCLUDE_PATHS=/health/live,/health/ready

# JWT Secret Key
# Generate with: openssl rand -hex 32
# Or Python: python -c 'import secrets; print(secrets.token_hex(32))'
# Must be 32+ characters. DO NOT use the example below in production!
JWT_SECRET_KEY=CHANGE_ME_TO_A_SECURE_RANDOM_VALUE_32_CHARS_MIN

# How long the access token is valid for, in minutes. Defaults to 30
JWT_ACCESS_TOKEN_MINUTES=30

# Invoice upload limits
UPLOAD_MAX_BYTES=10485760
UPLOAD_RATE_LIMIT=20
UPLOAD_RATE_LIMIT_WINDOW_SECONDS=60

# Local invoice storage path for development and CI
STORAGE_LOCAL_PATH=./data/invoices
