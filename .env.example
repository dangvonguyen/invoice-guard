# Database settings - REQUIRED
# Replace the values below with your PostgreSQL credentials.
POSTGRES_USER=your_database_username
POSTGRES_PASSWORD=your_secure_database_password
POSTGRES_DB=your_database_name

# Connect settings for running the backend locally.
# When using Docker Compose, it overrides these values for containers
# on its internal network.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Configure these with your own Docker registry images
DOCKER_BACKEND_IMAGE=invoice-guard-backend
DOCKER_FRONTEND_IMAGE=invoice-guard-frontend
