{
  "name": "frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "serve": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest --ui",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm lint && pnpm format:check && pnpm build",
    "gen:api": "openapi-typescript ./api/openapi.yml -o ./src/shared/api/schema.d.ts"
  },
