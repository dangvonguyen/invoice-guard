# The root path for the API. This is the path that the API will be served from.
API_ROOT=/api

# List of origins that can access this API, separated by a comma,
# eg: CORS_ORIGINS=http://localhost,https://www.example.com
CORS_ORIGINS=*

# JWT Secret Key
# Generate with: openssl rand -hex 32
# Or Python: python -c 'import secrets; print(secrets.token_hex(32))'
# Must be 32+ characters. DO NOT use the example below in production!
JWT_SECRET_KEY=CHANGE_ME_TO_A_SECURE_RANDOM_VALUE_32_CHARS_MIN

# How long the access token is valid for, in minutes. Defaults to 30
JWT_ACCESS_TOKEN_MINUTES=30

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL. Defaults to INFO
LOG_LEVEL=INFO
# Comma-separated endpoints excluded from routine request logs.
LOG_EXCLUDE_PATHS=/health/live,/health/ready

# PostgreSQL connection settings - REQUIRED
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=CHANGE_ME
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis connection settings, used for rate limiting
REDIS_HOST=localhost
REDIS_PORT=6379

# Invoice upload limits
UPLOAD_MAX_BYTES=10485760
UPLOAD_RATE_LIMIT=20
UPLOAD_RATE_LIMIT_WINDOW_SECONDS=60

# Local invoice storage path for development and CI
STORAGE_LOCAL_PATH=./data/invoices

# API keys - REQUIRED
OPENAI_API_KEY=CHANGE_ME
ANTHROPIC_API_KEY=CHANGE_ME

# Embedding model, used for policy handbook retrieval
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Extraction settings: which provider/model pulls fields off an invoice
EXTRACTION_PROVIDER=openai
EXTRACTION_MODEL=gpt-5-mini
EXTRACTION_MAX_TOKENS=4096

# Explanation generation: which provider/model explains a review flag
GENERATION_PROVIDER=openai
GENERATION_MODEL=gpt-5-mini
GENERATION_MAX_TOKENS=4096
EXPLANATION_RETRIEVAL_TOP_K=5

# Extraction reconciliation - recovers stuck/interrupted extraction jobs
EXTRACTION_RECONCILE_INTERVAL_SECONDS=600
EXTRACTION_RECONCILE_STALE_AFTER_SECONDS=1200
EXTRACTION_RECONCILE_BATCH_LIMIT=100

# Deterministic rule engine thresholds
RULE_MAX_EXPENSE_AMOUNT=1000.00
RULE_MAX_EXPENSE_AGE_DAYS=90
RULE_ALLOWED_CURRENCIES=USD,EUR,GBP
RULE_RECONCILIATION_TOLERANCE=0.01

# Policy handbook ingestion
POLICY_CHUNK_MIN_TOKENS=100
POLICY_CHUNK_MAX_TOKENS=500
POLICY_DOCUMENT_MAX_BYTES=52428800
