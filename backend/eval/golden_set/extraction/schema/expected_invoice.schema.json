{
  "$defs": {
    "ExtractedLineItem": {
      "description": "One line item on an invoice.",
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Amount"
        },
        "quantity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quantity"
        },
        "unit_price": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit Price"
        }
      },
      "required": [
        "description",
        "amount"
      ],
      "title": "ExtractedLineItem",
      "type": "object"
    }
  },
  "description": "Schema-constrained fields the extraction model must return.",
  "properties": {
    "vendor_name": {
      "title": "Vendor Name",
      "type": "string"
    },
    "invoice_number": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Invoice Number"
    },
    "invoice_date": {
      "format": "date",
      "title": "Invoice Date",
      "type": "string"
    },
    "total_amount": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Total Amount"
    },
    "currency": {
      "title": "Currency",
      "type": "string"
    },
    "tax_amount": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tax Amount"
    },
    "line_items": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ExtractedLineItem"
      },
      "title": "Line Items",
      "type": "array"
    }
  },
  "required": [
    "vendor_name",
    "invoice_date",
    "total_amount",
    "currency"
  ],
  "title": "ExtractedInvoice",
  "type": "object"
}
