    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-dropzone": "^20.1.0",
    "react-router": "^8.3.0",
    "shadcn": "^4.16.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
